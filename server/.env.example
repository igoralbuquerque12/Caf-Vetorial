OPENAI_API_KEY=
# JWT_SECRET precisa ter no mínimo 32 caracteres (256 bits, exigência do HS256)
JWT_SECRET=
S3_BUCKET=
AWS_REGION=
S3_ENDPOINT=
# As credenciais da AWS (AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY) NÃO vão no .env,
# pois spring.config.import expõe valores como propriedades do Spring e não como variáveis de ambiente do SO.
# Configure suas credenciais em ~/.aws/credentials executando `aws configure`.
